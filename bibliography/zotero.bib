@article{granucciSurfaceHoppingTrajectory2012,
  title = {Surface Hopping Trajectory Simulations with Spin-Orbit and Dynamical Couplings},
  author = {Granucci, Giovanni and Persico, Maurizio and Spighi, Gloria},
  year = 2012,
  month = jul,
  journal = {The Journal of Chemical Physics},
  volume = {137},
  number = {22},
  pages = {22A501},
  issn = {0021-9606},
  doi = {10.1063/1.4707737},
  abstract = {In this paper we consider the inclusion of the spin-orbit interaction in surface hopping molecular dynamics simulations to take into account spin forbidden transitions. Two alternative approaches are examined. The spin-diabatic one makes use of eigenstates of the spin-free electronic Hamiltonian and of \textbackslash documentclass[12pt]\textbraceleft minimal\textbraceright\textbackslash begin\textbraceleft document\textbraceright\textbackslash hat\textbraceleft S\textbraceright\textasciicircum 2\textbackslash end\textbraceleft document\textbraceright\^S2 and is commonly applied when the spin-orbit coupling is weak. We point out some inconsistencies of this approach, especially important when more than two spin multiplets are coupled. The spin-adiabatic approach is based on the eigenstates of the total electronic Hamiltonian including the spin-orbit coupling. Advantages and drawbacks of both strategies are discussed and illustrated with the help of two model systems.}
}
